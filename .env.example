# EasyTool Backend Environment Template
# Copy this file to .env and fill in your private API keys:
# cp .env.example .env

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# remove.bg API Key (Get free key from https://www.remove.bg/api)
REMOVE_BG_API_KEY=your_remove_bg_api_key_here

# Server Port
PORT=8080
